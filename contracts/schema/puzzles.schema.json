{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "puzzles.schema.json",
  "title": "Puzzle index",
  "description": "The game reads this first. It lists puzzles WITHOUT their outcomes (no spoilers). The UI reads puzzle filenames from here and never builds them.",
  "type": "object",
  "required": ["schema_version", "conflict_threshold_m", "difficulties", "puzzles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.1"},
    "is_mock": {"type": "boolean"},
    "conflict_threshold_m": {"type": "number", "exclusiveMinimum": 0, "description": "Closest approach below this while the vehicle is in the crossing zone = conflict (HOLD was right)"},
    "difficulties": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "name", "description"], "additionalProperties": false,
      "properties": {
        "id": {"enum": ["clear", "busy", "fog"]},
        "name": {"type": "string"},
        "description": {"type": "string"}
      }}},
    "puzzles": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "difficulty", "title", "file"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "difficulty": {"enum": ["clear", "busy", "fog"]},
        "title": {"type": "string", "description": "Short label for menus. Must not give away the answer."},
        "file": {"type": "string", "pattern": "^puzzle_[a-z0-9_]+\\.json$"}
      }}}
  }
}
